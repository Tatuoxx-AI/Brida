# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# chave pública (sb_publishable_…); a antiga "anon key" também serve
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor (webhooks e IA). Nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Stripe (usar chaves de teste sk_test_/pk_test_ em desenvolvimento)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI — agente de agendamento
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp: "twilio" ou "evolution"
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# segredo partilhado para validar o webhook de entrada
WHATSAPP_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3240

# Área do gerente (ponto final do título → 3 toques). Endereço e senha secretos.
MANAGER_PATH=estudio-troque-isto
MANAGER_PASSWORD=
MANAGER_SESSION_SECRET=

# Postgres do Supabase (Project Settings → Database → Connection string, modo "Session").
# Sem isto a app usa uma base local em .data/pg (só para desenvolvimento).
DATABASE_URL=

# Cifra dos tokens das integrações guardados na base (NÃO perder: sem ela os tokens têm de ser reintroduzidos)
DATA_ENCRYPTION_KEY=
# Protege /api/cron/automations (lembretes 24h e aniversários)
CRON_SECRET=
